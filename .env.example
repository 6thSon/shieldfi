# ShieldFi Environment Variables
# Copy this file to .env and fill in your real values

# Your wallet mnemonic (12-24 words) — used for Sepolia deployment
# NEVER commit real mnemonics to git
MNEMONIC=your_wallet_mnemonic_here

# Infura API key for Sepolia RPC access
# Get yours at: https://infura.io
INFURA_API_KEY=your_infura_api_key_here

# Network configuration (Sepolia testnet)
NEXT_PUBLIC_CHAIN_ID=11155111

# (Optional) Etherscan API key for contract verification
ETHERSCAN_API_KEY=your_etherscan_api_key_here
